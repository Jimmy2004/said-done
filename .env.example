# Optional non-secret overrides. The MCP server reads SAID_DONE_CONFIG.
# SAID_DONE_HOME=/absolute/path/to/config-home
# SAID_DONE_CONFIG=/absolute/path/to/config.json
# SAID_DONE_DATA_DIR=/absolute/path/to/data
# Prefer setup_begin/import_credentials and the system keychain for credentials.
# CI only: SAID_DONE_API_KEY_DEFAULT can supply an API key from the CI secret store.
# Legacy MINIMAX_API_KEY remains supported; never commit a populated .env.
